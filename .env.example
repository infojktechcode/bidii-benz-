# Copy to .env and adjust. NEVER commit .env.

APP_ENV=development
APP_DEBUG=1
APP_URL=http://localhost/bidii-benz/public
APP_NAME=Bidii Benz Rentals

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bidii_benz
DB_USER=root
DB_PASS=

# Session hardening (seconds)
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

# Uploads
UPLOAD_MAX_BYTES=2097152

# M-Pesa Daraja
# env: mock (auto-confirm, no external call) | sandbox | live
# sandbox/live REFUSE to confirm until real STK credentials are supplied.
MPESA_ENV=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# Shared secret required in the X-Callback-Token header on /payment/callback.
MPESA_CALLBACK_SECRET=
