# Copy to .env and adjust. NEVER commit .env.

# Production: APP_ENV=production, APP_DEBUG=0, APP_URL=https://... —
# full checklist in docs/deploy.md.
APP_ENV=development
APP_DEBUG=1
APP_URL=http://localhost/bidii-benz/public
APP_NAME=Bidii Benz Rentals

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bidii_benz
# Development default (stock XAMPP root). Production must use a dedicated
# least-privilege account — docs/deploy.md §4.
DB_USER=root
DB_PASS=

# Session hardening (seconds)
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

# Uploads
UPLOAD_MAX_BYTES=2097152

# M-Pesa Daraja
# env: mock (auto-confirm, no external call) | sandbox | live
# sandbox/live REFUSE to confirm until real STK credentials are supplied.
# Production refuses mock outright; set MPESA_CALLBACK_SECRET before live
# callbacks. Rotate parked/sandbox credentials before any live use —
# docs/deploy.md §9. Real values never go into version control.
MPESA_ENV=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# Shared secret required in the X-Callback-Token header on /payment/callback.
MPESA_CALLBACK_SECRET=

# Audit trail retention (owner policy, Kenya DPA storage limitation).
# scripts/prune.php deletes audit_logs rows older than this many months.
AUDIT_RETENTION_MONTHS=12
